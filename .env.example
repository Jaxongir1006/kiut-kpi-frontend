# =============================================================================
# KIUT KPI frontend — environment
# =============================================================================
# Copy to .env for local development. .env is gitignored and must never be
# committed.
#
# Vite inlines every VITE_* value into the bundle AT BUILD TIME. Two
# consequences that matter:
#
#   1. Nothing here is a secret. Whatever you put in a VITE_ variable is
#      readable by anyone who opens the built JavaScript. Never put an API key,
#      a token, or a password in this file.
#   2. It cannot be changed on the server after the fact. Pointing a deployed
#      build at a different API means rebuilding and redeploying, not editing a
#      file on the host.
# -----------------------------------------------------------------------------

# Base URL of the Django API. The SPA is served from kiut-kpi.duckdns.org and
# the API lives on a SEPARATE origin, so this must be the absolute https URL --
# a relative value like "api" would resolve against the SPA's own origin and
# every request would 404.
#
# Because the origins differ, the backend must also list
# https://kiut-kpi.duckdns.org in CORS_ALLOWED_ORIGINS, or the browser blocks
# every response before the app ever sees it.
VITE_API_URL=https://api-kpi.duckdns.org

# For local development against a backend on your own machine:
# VITE_API_URL=http://127.0.0.1:8000
